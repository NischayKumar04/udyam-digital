# Copy this file to .env and fill in your own keys. .env is git-ignored; never commit it.
# Both keys are free. The advisor uses Groq first and falls back to Gemini, then to a
# guided flow that needs no AI at all, so a rate limit can't break a live demo.

# https://console.groq.com/keys
GROQ_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Check these against each provider's current model list before relying on them.
# Groq's limits apply per model, so listing several gives more free capacity.
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-3.6-flash
